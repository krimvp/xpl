                "to": 35
              },
              "role": "definition"
            }
          ],
          "editor": {
            "primary": "internal/runner/runner.go"
          }
        },
        {
          "id": "t3",
          "view": "view:retry",
          "focus": ["retry:5", "concept:retry-policy"],
          "note": "### A job gets a fixed number of retries\n\nWith the default `maxRetries: 3`, a job that keeps failing runs four times: the first attempt and three retries.",
          "code": [
            {
              "file": "internal/runner/runner.go",
              "symbol": "Runner.Dispatch",
              "span": {
                "from": 34,
                "to": 35
              },
              "role": "call-site"
            },
            {
              "file": "config/default.yaml",
              "symbol": "retry",
              "role": "config"
            }
          ],
          "editor": {
            "primary": "internal/runner/runner.go"
          }
        },
        {
          "id": "t4",
          "view": "view:retry",
          "focus": ["retry:6"],
          "note": "### The delay doubles after each failure\n\nWith the default settings, the three retries wait 500 ms, 1 s and 2 s. The 30 s cap is not reached.",
          "code": [
            {
              "file": "internal/runner/runner.go",
              "symbol": "backoffDelay",
              "role": "definition"
            },
            {
              "file": "config/default.yaml",
              "symbol": "retry",
              "role": "config"
            }
          ],
          "editor": {
            "primary": "internal/runner/runner.go"
          }
        },
        {
          "id": "t5",
          "view": "view:retry",
          "focus": ["retry:7"],
          "note": "### The queue holds the job back without a timer\n\n`Requeue` does not sleep. `Requeue` sets `AvailableAt` to the time the job is due, and `Pop` skips the job until then.",
          "code": [

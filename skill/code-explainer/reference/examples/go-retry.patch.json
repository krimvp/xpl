    {
      "id": "concept:retry-policy",
      "label": "Retry policy",
      "summary": "A failed job is requeued with exponential backoff (BaseDelay * 2^(attempt-1), capped at MaxDelay) while attempts <= MaxRetries, then dead-lettered.",
      "anchors": [
        {
          "file": "internal/runner/runner.go",
          "symbol": "Runner.Dispatch",
          "span": {

  "nodes": [
    {
      "id": "grp:retry-engine",
      "label": "Retry engine",
      "summary": "The code that handles a failed job. `runner.go` decides what happens next; the queue stores the job again or dead-letters it.",
      "members": [
        "file:internal/runner/runner.go",
        "file:internal/queue/queue.go",
        "file:internal/queue/deadletter.go"
      ]
    },
    {
      "id": "grp:retry-config",
      "label": "Retry settings",
      "summary": "The three retry numbers start in `config/default.yaml`. `config.Parse` reads them, and `runnerConfig` passes them to the runner.",
      "members": [
        "file:config/default.yaml",
        "file:internal/config/config.go",
        "sym:cmd/jobrunner/main.go#runnerConfig"
      ]
    },
    {
      "id": "sym:internal/runner/runner.go#Runner.Dispatch",
      "summary": "The dispatch loop: pop a job, lease a worker and run the job. Then ack it, requeue it with a delay, or dead-letter it."
    },
    {
      "id": "sym:internal/runner/runner.go#backoffDelay",
      "summary": "Doubles `BaseDelay` once per earlier failed attempt and caps the result at `MaxDelay`."
    },
    {
      "id": "sym:internal/worker/worker.go#Worker",
      "summary": "Runs one attempt of a job. A handler error, a panic or a timeout comes back in `Result.Err`, not as an error return."
    },
    {
      "id": "sym:internal/queue/queue.go#Queue",
      "summary": "In-memory priority queue with an in-flight set. `Requeue`, `Ack` and `DeadLetter` first take the job out of the in-flight set."
    },
    {
      "id": "file:internal/runner/runner.go",
      "summary": "The dispatch loop and the retry policy. After a failed attempt, the runner requeues the job with a delay or dead-letters it."
    },
    {
      "id": "file:internal/queue/queue.go",
      "summary": "The in-memory queue: `Push`, `Pop` (highest priority first, skipping jobs that are not due), `Requeue` and `Ack`."
    },
    {
      "id": "file:internal/queue/deadletter.go",
      "summary": "`Queue.DeadLetter` keeps a job that has no retries left, with its last error. `Queue.Dead` lists those jobs."
    },
    {
      "id": "file:internal/worker/worker.go",
      "summary": "`Worker.Run` runs one attempt with a timeout and returns the outcome as a `Result`. A success is also published on the bus."
    },
    {
      "id": "file:internal/config/config.go",
      "summary": "Parses `config/default.yaml` by hand into typed structs. `config.Retry` holds the three retry settings."
    },
    {
      "id": "file:config/default.yaml",
      "summary": "Default settings. The `retry` block allows 3 retries, with a first delay of 500 ms and a cap of 30 s."
    },
    {
      "id": "sym:cmd/jobrunner/main.go#runnerConfig",
      "summary": "Copies the retry settings, the idle delay and the worker timeout from the loaded config into `runner.Config`."
    }
  ],

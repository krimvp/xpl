{
  "nodes": [
    {
      "id": "grp:retry-engine",
      "label": "Retry engine",
      "summary": "The runner decides whether a failed job gets another attempt; the queue stores the requeued or dead-lettered job.",
      "members": [
        "file:internal/runner/runner.go",
        "file:internal/queue/queue.go",
        "file:internal/queue/deadletter.go"
      ]
    },
    {
      "id": "grp:retry-config",
      "label": "Retry configuration",
      "summary": "retry.maxRetries, baseDelayMs and maxDelayMs travel from the YAML file through config.Parse and main into the runner.",
      "members": [
        "file:config/default.yaml",
        "file:internal/config/config.go",
        "sym:cmd/jobrunner/main.go#runnerConfig"
      ]
    },
    {
      "id": "sym:internal/runner/runner.go#Runner.Dispatch",
      "summary": "The dispatch loop: pop a job, lease a worker, run it, then ack it or, if it failed, requeue it with backoff or dead-letter it."
    },
    {
      "id": "sym:internal/runner/runner.go#backoffDelay",
      "summary": "Exponential backoff: BaseDelay doubled once per earlier attempt, capped at MaxDelay."
    },
    {
      "id": "sym:internal/worker/worker.go#Worker",
      "summary": "Runs one attempt of a job; failures, panics and timeouts come back as a Result, never as an error to the caller."
    },
    {
      "id": "sym:internal/queue/queue.go#Queue",
      "summary": "In-memory priority queue with an in-flight set; Requeue and DeadLetter both release the job from in-flight first."
    },
    {
      "id": "file:internal/runner/runner.go",
      "summary": "The dispatch loop and the retry policy: it decides, after each failed attempt, between requeueing with backoff and dead-lettering."
    },
    {
      "id": "file:internal/queue/queue.go",
      "summary": "The in-memory queue: Push, Pop (highest priority first, skipping jobs that are not due), Requeue and Ack."
    },
    {
      "id": "file:internal/queue/deadletter.go",
      "summary": "Queue.DeadLetter parks a job that ran out of retries, with its last error; Queue.Dead lists them."
    },
    {
      "id": "file:internal/worker/worker.go",
      "summary": "Worker.Run executes one attempt with a timeout and reports the outcome as a Result; only successes are announced on the bus."
    },
    {
      "id": "file:internal/config/config.go",
      "summary": "Parses config/default.yaml by hand into typed structs; config.Retry holds the three retry settings."
    },
    {
      "id": "file:config/default.yaml",
      "summary": "Default settings; the retry block allows 3 retries with a 500 ms base delay capped at 30 s."
    },
    {
      "id": "sym:cmd/jobrunner/main.go#runnerConfig",
      "summary": "Copies the retry settings (and the idle delay and worker timeout) from the loaded config into runner.Config."
    }
  ],

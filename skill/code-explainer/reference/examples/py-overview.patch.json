{
  "nodes": [
    {
      "id": "grp:scheduling",
      "label": "Scheduling",
      "summary": "Decides which job runs next, hands it to a worker, and requeues or dead-letters failures.",
      "members": ["file:jobrunner/runner.py", "file:jobrunner/queue.py"]
    },
    {
      "id": "grp:events",
      "label": "Events and metrics",
      "summary": "A topic bus plus the metrics that subscribe to it; publishers and subscribers share only a topic name.",
      "members": ["file:jobrunner/bus.py", "file:jobrunner/metrics.py"]
    },
    {
      "id": "grp:configuration",
      "label": "Configuration",
      "summary": "The YAML defaults and the hand-written loader that turns them into typed config objects.",
      "members": ["file:config/default.yaml", "file:jobrunner/config.py"]
    },
    {
      "id": "file:jobrunner/__main__.py",
      "summary": "Entry point: loads the config, wires bus, metrics, workers, queue and runner together, and runs a short demo."
    },
    {
      "id": "file:jobrunner/worker.py",
      "summary": "Runs one job attempt with a timeout and reports the outcome; a pool leases workers one at a time."
    },
    {
      "id": "file:config/default.yaml",
      "summary": "Default settings for the queue, workers, retry policy and metrics."
    },
    {
      "id": "file:jobrunner/bus.py",
      "summary": "EventBus: subscribe to a string topic with on(), deliver a payload to every subscriber with emit()."
    },
    {
      "id": "file:jobrunner/config.py",
      "summary": "Parses the small YAML subset by hand and validates it into QueueConfig, WorkersConfig, RetryConfig and MetricsConfig."
    },
    {
      "id": "file:jobrunner/metrics.py",
      "summary": "Counts completed jobs and their durations; on_job_completed runs only when the bus delivers job.completed."
    },
    {
      "id": "file:jobrunner/queue.py",
      "summary": "The in-memory job queue: push, pop (by priority, then age), requeue with a delay, ack and dead-letter."
    },
    {
      "id": "file:jobrunner/runner.py",
      "summary": "Runner.dispatch is the loop that pops a job, runs it on a worker, and acks, requeues with backoff or dead-letters it."
    },
    {
      "id": "sym:jobrunner/__main__.py#run",
      "summary": "Wires config, bus, metrics, workers, queue and runner together, pushes three demo jobs and waits for the queue to drain."
    }
  ],

#!/usr/bin/env node
// Launcher for the installed CLI, with a source-development fallback.
//
// xpl skill install writes xpl-install.json with the CLI path. Updates replace the binding too.
// XPL_CLI overrides it. Importing runs with the same argv, stdio, signals and exit code.
import { existsSync, readFileSync, realpathSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const self = realpathSync(fileURLToPath(import.meta.url)); // <repo>/skill/code-explainer/bin/xpl
const repo = resolve(dirname(self), "../../..");
const binding = resolve(dirname(self), "../xpl-install.json");
const installation = existsSync(binding) ? JSON.parse(readFileSync(binding, "utf8")) : undefined;
const installedCli = installation?.cli;
const sourceCli = resolve(repo, "packages/cli/dist/xpl.mjs");
const cli = process.env.XPL_CLI ? resolve(process.env.XPL_CLI) : (installedCli ?? sourceCli);

if (!existsSync(cli)) {
  console.error(`xpl: the CLI is unavailable: ${cli} does not exist.`);
  if (process.env.XPL_CLI) {
    console.error("XPL_CLI is set; point it at a built xpl.mjs or unset it.");
  } else if (installedCli) {
    console.error(
      "Reinstall xpl from npm or a local tarball in this environment, then run `xpl skill install` to update this launcher.",
    );
  } else {
    console.error(
      `Build it once from the repository root:\n  cd ${repo} && npm install && npm run build`,
    );
    console.error(
      "(If this skill directory was copied out of the repo, symlink it instead, or set XPL_CLI.)",
    );
  }
  process.exit(1);
}

if (typeof installation?.version === "string") {
  try {
    const cliVersion = JSON.parse(
      readFileSync(resolve(dirname(cli), "package.json"), "utf8"),
    ).version;
    if (typeof cliVersion === "string" && cliVersion !== installation.version) {
      console.error(
        `xpl: installed skill ${installation.version} differs from CLI ${cliVersion}; run \`xpl skill install\`.`,
      );
    }
  } catch {
    // A custom XPL_CLI may have no package metadata beside it.
  }
}

await import(pathToFileURL(cli).href);

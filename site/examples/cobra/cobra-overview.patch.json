              "symbol": "Command.ExecuteC",
              "span": {
                "from": 58,
                "to": 64
              },
              "role": "usage"
            }
          ],
          "note": "### The root selects the command that runs\n\nThe root searches its child command tree, then passes the remaining input to the selected command. That command checks its own flags and handler.",
          "editor": {
            "primary": "command.go"
          }
        },
        {
          "id": "t3",
          "view": "view:overview",
          "focus": [
            "file:args.go",
            "file:flag_groups.go"
          ],
          "code": [

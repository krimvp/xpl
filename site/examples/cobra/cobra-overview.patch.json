  "tours": [
    {
      "id": "tour:overview",
      "title": "How Cobra builds and runs Go commands",
      "summary": "Cobra is a Go library for command-line programs. Applications define commands and handlers; Cobra selects a command, parses flags, checks arguments, and runs the handler. Separate parts supply completion and reference documentation. This tour shows the library structure and the main execution path.",
      "steps": [
        {
          "id": "t1",
          "view": "view:system",
          "focus": [
            "grp:cobra"
          ],
          "code": [
            {
              "file": "README.md",
              "span": {
                "from": 36,
                "to": 36
              },
              "role": "usage"
            },
            {
              "file": "site/content/user_guide.md",
              "span": {
                "from": 57,
                "to": 61
              },
              "role": "usage"
            }
          ],
          "note": "### A Go app delegates command handling to Cobra\n\nYour Go app defines commands and calls Cobra to process its input. Cobra uses pflag for flag sets; the app supplies the work each command performs.",
          "editor": {
            "primary": "README.md"
          }
        },
        {
          "id": "t2",
          "view": "view:overview",
          "focus": [
            "file:command.go"
          ],
          "code": [
            {
              "file": "command.go",
              "symbol": "Command.ExecuteC",
              "span": {
                "from": 35,
                "to": 40
              },
              "role": "usage"
            },
            {

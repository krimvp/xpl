              "symbol": "Command.ExecuteC",
              "span": {
                "from": 67,
                "to": 70
              },
              "role": "usage"
            }
          ],
          "note": "### Help requests and non-runnable commands exit\n\nThe runnable check follows the version route. Argument validation comes after both help exits.",
          "editor": {
            "primary": "command.go"
          }
        },
        {
          "id": "t5",
          "view": "view:execution",
          "focus": [
            "execution:6"

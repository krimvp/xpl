              "symbol": "Command.execute",
              "span": {
                "from": 50,
                "to": 64
              },
              "role": "usage"
            }
          ],
          "note": "### Positional arguments get checked before hooks\n\nWhen a runnable command reaches this step, argument validation can stop execution before any configured pre-run hook.",
          "editor": {
            "primary": "command.go"
          }
        },
        {
          "id": "t6",
          "view": "view:execution",
          "focus": [

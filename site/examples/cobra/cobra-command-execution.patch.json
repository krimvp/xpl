              "symbol": "Command.execute",
              "span": {
                "from": 102,
                "to": 115
              },
              "role": "usage"
            }
          ],
          "note": "### Flag rules guard the app handler\n\nCobra checks required flags and flag groups before calling the app’s `RunE` or `Run` handler. A `RunE` error stops the normal post-run path.",
          "editor": {
            "primary": "command.go"
          }
        },
        {
          "id": "t8",
          "view": "view:execution",
          "focus": [

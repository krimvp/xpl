              "file": "packages/cli/src/commands/apply.ts",
              "symbol": "applyCommand",
              "role": "definition"
            }
          ],
          "note": "### A patch changes the guide only after checks\n\nThe command reads one patch and one saved guide. The core returns either a checked replacement or the original guide with issues.",
          "editor": {
            "primary": "packages/cli/src/commands/apply.ts"
          }
        },
        {

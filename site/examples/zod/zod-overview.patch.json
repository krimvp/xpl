  "tours": [
    {
      "id": "tour:overview",
      "title": "How Zod validates data with schemas",
      "summary": "Zod is a TypeScript-first validation library. An application defines a schema and parses data against it. The classic API delegates to a core runtime that gathers a parsed value and any validation issues. A caller can request a throwing parse or a result object that reports success.",
      "steps": [
        {

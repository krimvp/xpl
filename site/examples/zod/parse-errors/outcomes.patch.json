          "view": "view:outcome",
          "focus": [
            "outcome:5",
            "outcome:9"
          ],
          "note": "### Issues produce different outcomes\n\nThe choice here is between catching an exception and branching on a result flag. Follow the source links for each branch.",
          "code": [
            {
              "file": "packages/zod/src/v4/core/parse.ts",
              "symbol": "_parse",
              "find": "throw e;",
              "role": "definition"
            },
            {
              "file": "packages/zod/src/v4/core/parse.ts",
              "symbol": "_safeParse",

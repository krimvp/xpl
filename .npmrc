# The tree-sitter grammar packages ship prebuilt .wasm files, which is all this repo loads.
# Their `install` script (node-gyp-build) only concerns the native bindings, which we never use,
# and falls back to a slow node-gyp compile on platforms without a matching prebuild.
# So dependency install scripts are skipped repo-wide (esbuild, playwright, vite, tsx and
# typescript all work without them).
# Consequence: npm also skips pre*/post* scripts of our own packages, so do not use them.
ignore-scripts=true

# Quieter, faster installs.
fund=false
audit=false

{
  "name": "xpl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Code Explainer: interactive, two-way linked diagrams and code. See docs/ARCHITECTURE.md.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build -w @xpl/viewer && npm run build -w @xpl/cli",
    "site": "node scripts/build-site.mjs",
    "pack": "npm run build && npm pack ./packages/cli/dist",
    "test:install": "npm run build && node scripts/test-install.mjs",
    "test:e2e": "npm run test:e2e -w @xpl/viewer",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:install:platform": "npm run build && node scripts/test-install-platform.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@lezer/javascript": "1.5.4",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@codemirror/view": "6.43.13",
    "@codemirror/state": "6.7.6",
    "@dagrejs/dagre": "3.0.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/mocker": "5.0.3",
    "@vitest/spy": "5.0.3",
    "magic-string": "1.2.3",
    "marked": "18.1.0",
    "nanoid": "3.3.18",
    "obug": "2.1.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rolldown": "1.2.7",
    "style-mod": "4.1.3",
    "vite": "8.3.2"
  }
}

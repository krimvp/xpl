{
  "name": "xpl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Code Explainer: interactive, two-way linked diagrams and code. See docs/ARCHITECTURE.md.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build -w @xpl/viewer && npm run build -w @xpl/cli",
    "test:e2e": "npm run test:e2e -w @xpl/viewer",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}

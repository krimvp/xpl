{
  "name": "xpl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Code Explainer: interactive, two-way linked diagrams and code. See docs/ARCHITECTURE.md.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build -w @xpl/viewer && npm run build -w @xpl/cli",
    "test:e2e": "npm run test:e2e -w @xpl/viewer",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "@lezer/javascript": "1.5.4",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@codemirror/view": "6.43.11",
    "@codemirror/state": "6.7.4",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/mocker": "5.0.0",
    "@vitest/spy": "5.0.0",
    "magic-string": "1.2.3",
    "marked": "18.0.12",
    "nanoid": "3.3.18",
    "obug": "2.1.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rolldown": "1.2.7",
    "style-mod": "4.1.3",
    "vite": "8.2.2"
  }
}

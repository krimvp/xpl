{
  "name": "@xpl/viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "xpl viewer: React + CodeMirror 6 + elkjs, built into one self-contained dist/index.html.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "bundle": "tsx scripts/make-bundle.ts",
    "bundle:ts": "tsx scripts/make-bundle.ts ../../fixtures/ts-jobrunner --name jobrunner --title \"Job runner\" --repo acme/jobrunner --patch scripts/ts-example.patch.json",
    "test:e2e": "vite build && playwright test"
  },
  "dependencies": {
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@xpl/core": "*",
    "elkjs": "^0.12.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}

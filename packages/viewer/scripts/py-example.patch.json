      "id": "view:dispatch",
      "type": "sequence",
      "title": "How a job is dispatched",
      "scope": {
        "root": "repo",
        "depth": 3,
        "question": "How does a job get from the queue to a worker?",
        "entryPoints": ["jobrunner/runner.py#Runner.dispatch"]
      },
      "participants": [
        "sym:jobrunner/runner.py#Runner.dispatch",
        "file:jobrunner/queue.py",
        "file:jobrunner/worker.py"
      ],
      "steps": [
        {
          "id": "dispatch:1",
          "from": "sym:jobrunner/runner.py#Runner.dispatch",
          "to": "file:jobrunner/queue.py",
          "label": "pop()",
          "kind": "call",
          "summary": "Takes the next job that is due: highest priority first, then oldest enqueue time. Returns None when nothing is due, and the loop sleeps for idle_delay_ms.",
          "anchors": [
            {
              "file": "jobrunner/runner.py",
              "symbol": "Runner.dispatch",
              "span": { "from": 4, "to": 4 },
              "role": "call-site"
            },
            { "file": "jobrunner/queue.py", "symbol": "Queue.pop", "role": "definition" }
          ]
        },
        {
          "id": "dispatch:2",
          "from": "sym:jobrunner/runner.py#Runner.dispatch",
          "to": "file:jobrunner/worker.py",
          "label": "run(job)",
          "kind": "call",
          "summary": "Runs one attempt on the leased worker, with the configured timeout. A failure (exception, timeout, unknown job kind) comes back as RunResult(ok=False, error=...), never as a raised exception; a success is also published on the bus as job.completed.",
          "anchors": [
            {
              "file": "jobrunner/runner.py",
              "symbol": "Runner.dispatch",
              "span": { "from": 16, "to": 16 },
              "role": "call-site"
            },
            { "file": "jobrunner/worker.py", "symbol": "Worker.run", "role": "definition" }
          ]
        },
        {
          "id": "dispatch:3",
          "from": "sym:jobrunner/runner.py#Runner.dispatch",
          "to": "file:jobrunner/queue.py",
          "label": "requeue(job, backoff)",
          "kind": "call",
          "summary": "A failed job with retries left goes back on the queue, due again after backoff_delay: base_delay_ms * 2^(attempt-1), capped at max_delay_ms. Queue.requeue records the failed attempt and keeps the job's original enqueue time.",
          "anchors": [
            {
              "file": "jobrunner/runner.py",
              "symbol": "Runner.dispatch",
              "span": { "from": 29, "to": 29 },
              "role": "call-site"
            },
            { "file": "jobrunner/queue.py", "symbol": "Queue.requeue", "role": "definition" }
          ]
        }
      ],
      "frames": [
        {
          "id": "frame:retry",
          "kind": "loop",
          "label": "until success or maxRetries",
          "fromStep": "dispatch:2",
          "toStep": "dispatch:3"
        }
      ]

      "id": "grp:scheduling",
      "kind": "group",
      "parent": "repo",
      "label": "Scheduling",
      "summary": "Decides which job runs next and hands it to a free worker: the queue serves the highest priority first, then the oldest job, and Runner.dispatch leases a worker for it.",
      "members": ["file:jobrunner/runner.py", "file:jobrunner/queue.py"],
      "anchors": []
    },
    {
      "id": "sym:jobrunner/runner.py#Runner.dispatch",
      "kind": "symbol",
      "parent": "file:jobrunner/runner.py",
      "label": "Runner.dispatch",
      "summary": "Async loop that runs until stopped: pops the next due job, runs it on a leased worker, then acks it, requeues it with backoff or dead-letters it.",
      "anchors": [
        { "file": "jobrunner/runner.py", "symbol": "Runner.dispatch", "role": "definition" }
      ]
    }
  ],
  "edges": [
    {
      "id": "edge:job-completed",
      "from": "file:jobrunner/worker.py",
      "to": "file:jobrunner/metrics.py",
      "kind": "emits",
      "label": "job.completed",
      "summary": "Worker.run publishes job.completed on the event bus after a successful attempt; register_metrics subscribes on_job_completed to that topic. Invisible to the call graph: the worker and the metrics never reference each other.",

                "status": "ok"
              }
            },
            {
              "file": "internal/queue/queue.go",
              "symbol": "Queue.Pop",
              "role": "definition",
              "hash": "sha256:b721dfdea704",
              "resolved": {
                "commit": "wt-fd6c9886d1",
                "range": {
                  "startLine": 86,
                  "endLine": 108
                },
                "status": "ok"
              }
            }
          ],
          "summary": "r.queue is the JobQueue interface, which hides the implementation: the demo passes a *queue.Queue (the tests wrap one in a recording double), whose Pop hands out the next due job (highest priority first, then oldest) or returns queue.ErrEmpty, and then the loop sleeps for IdleDelay."
        },
        {
          "id": "dispatch:2",
          "from": "sym:internal/runner/runner.go#Runner.Dispatch",
          "to": "file:internal/worker/worker.go",
          "label": "Run(job)",
          "kind": "call",
          "anchors": [
            {
              "file": "internal/runner/runner.go",
              "symbol": "Runner.Dispatch",
              "span": {
                "from": 22,
                "to": 22
              },
              "role": "call-site",
              "hash": "sha256:3bfe041e8549",
              "resolved": {
                "commit": "wt-fd6c9886d1",
                "range": {
                  "startLine": 97,
                  "endLine": 97
                },
                "status": "ok"
              }
            },
            {
              "file": "internal/worker/worker.go",
              "symbol": "Worker.Run",
              "role": "definition",
              "hash": "sha256:0dcf3cd95023",
              "resolved": {
                "commit": "wt-fd6c9886d1",
                "range": {
                  "startLine": 45,
                  "endLine": 85
                },
                "status": "ok"
              }
            }
          ],
          "summary": "Runs one attempt on the leased worker; the context is detached from cancellation so a job in progress finishes during shutdown. Failures (errors, panics, timeouts) come back in Result.Err, never as a returned error or a panic; a success is also published on the bus as job.completed."
        },
        {
          "id": "dispatch:3",
          "from": "sym:internal/runner/runner.go#Runner.Dispatch",
          "to": "file:internal/queue/queue.go",
          "label": "Requeue(job, backoff)",
          "kind": "call",
          "anchors": [
            {
              "file": "internal/runner/runner.go",
              "symbol": "Runner.Dispatch",
              "span": {
                "from": 37,
                "to": 37
              },
              "role": "call-site",
              "hash": "sha256:84956281660f",
              "resolved": {
                "commit": "wt-fd6c9886d1",
                "range": {
                  "startLine": 112,
                  "endLine": 112
                },
                "status": "ok"
              }
            },
            {
              "file": "internal/queue/queue.go",
              "symbol": "Queue.Requeue",
              "role": "definition",
              "hash": "sha256:fd9d6d59dbb2",
              "resolved": {
                "commit": "wt-fd6c9886d1",
                "range": {
                  "startLine": 112,
                  "endLine": 124
                },
                "status": "ok"
              }
            }
          ],
          "summary": "A failed job with retries left goes back through JobQueue.Requeue, due again after backoffDelay: BaseDelay * 2^(attempt-1), capped at MaxDelay. The implementation, (*queue.Queue).Requeue, takes the job out of the in-flight set and appends a copy with Attempts+1 and AvailableAt set to now plus the delay."
        }
      ],
